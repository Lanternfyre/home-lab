#!/usr/sbin/nft -f
# Managed by Ansible -- ansible/roles/edge_firewall. Do not edit on the node.
#
# The public edge node's inbound policy. Everything on {{ edge_fw_tunnel_iface }}
# is trusted; everything arriving on {{ edge_fw_public_iface }} is not, and is
# dropped unless named below.
#
# ⚠️ INPUT ONLY. Nothing here touches forward or output, and that is
# deliberate: Cilium and kube-proxy own the forward path and program their own
# rules. A policy-drop forward chain here would break pod networking in a way
# that looks like a CNI fault.

# ── ATOMIC TABLE REPLACE, NOT `flush ruleset` ───────────────────────────────
#
# 🔴 THIS USED TO BE `flush ruleset`, AND THAT IS NOW A NODE OUTAGE.
#
# It was correct when written: this role is a PREREQUISITE OF THE JOIN, it ran
# on a machine where `nft list ruleset` was empty, and it owned everything.
# `roles/wg_guard` even cites that as the reason it could NOT do the same on a
# home node -- "flushing would take out every rule Cilium and kube-proxy have
# programmed".
#
# The edge node joined on 2026-09-06. It now runs cilium-agent and kube-proxy,
# both of which program their own rules, so THIS FILE NO LONGER OWNS THE
# RULESET. `flush ruleset` on a re-run would delete their rules out from under
# them and break pod networking on a public node -- and it would present as a
# CNI fault, not as a firewall change, which is the expensive kind of bug.
#
# Replacing only our own tables is exactly what `wg_guard` already does. The
# empty `table` declarations are NOT redundant: `delete table` FAILS on a table
# that does not exist, which would break the very first run on a fresh VPS.
# Declaring them empty first makes each delete unconditional.
#
# ⚠️ `edge_nat` is declared and deleted even when there are no DNAT entries, so
# that REMOVING the last entry actually removes the table rather than leaving
# the last rendered copy live forever.
table inet edge_filter {}
delete table inet edge_filter
table inet edge_nat {}
delete table inet edge_nat

table inet edge_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    # Conntrack first -- replies to connections this node opened.
    ct state established,related accept
    ct state invalid drop

    iif lo accept

    # The tunnel is the trusted side. Cluster traffic -- apiserver, kubelet,
    # VXLAN, Hubble, everything -- arrives here and is not enumerated port by
    # port, because enumerating it is how you discover a missing port during an
    # upgrade instead of during a change.
    iifname "{{ edge_fw_tunnel_iface }}" accept

    # ── 🔴 THE CNI INTERFACES. WITHOUT THIS, POD DNS ON THIS NODE HANGS. ───
    #
    # The header above says this file is INPUT ONLY because "Cilium and
    # kube-proxy own the forward path". That is true and it is not the whole
    # story: some pod traffic does not take the forward path at all. When a
    # CiliumNetworkPolicy carries an L7 rule -- `rules.dns`, which every
    # `toFQDNs` policy needs -- Cilium REDIRECTS the pod's packet to a proxy
    # listening in the HOST namespace. That packet arrives from the pod's veth
    # (`lxc*`) and is destined for this host, so it hits THIS CHAIN, matches
    # nothing, and dies on `policy drop`.
    #
    # MEASURED 2026-09-11, with the first ordinary pod ever scheduled here:
    #   * the pod's `getent hosts api.github.com` timed out after 20s
    #   * Hubble said `policy-verdict:L3-L4 EGRESS ALLOWED` then
    #     `to-proxy FORWARDED` -- Cilium was doing its job
    #   * the query reached CoreDNS on a home node and CoreDNS ANSWERED
    #   * and this chain's drop counter rose by 44 packets per DNS attempt
    # Adding the two rules below, and nothing else, made it resolve instantly.
    #
    # ⚠️ It is not only DNS. Anything that terminates on the host from a pod
    # takes this path: any future L7 policy, and the health-checker probing a
    # local endpoint. The symptom is always a HANG, never a refusal, because a
    # dropped packet on a policy-drop chain says nothing to anyone.
    #
    # ⚠️ Why this never bit before: until now the only pods on this node were
    # `hostNetwork` (the edge Envoy, node-exporter) or had no policy-selected
    # L7 path (smartctl-exporter). hostNetwork pods ARE the host and never
    # traverse a veth. The first non-hostNetwork pod with an L7 DNS policy is
    # what found it.
    #
    # This is the same trust statement as the tunnel rule above: traffic on
    # these interfaces originates from pods on THIS node, which are already
    # inside Cilium's policy domain and individually governed by their own
    # CiliumNetworkPolicy. That -- not this chain -- is the control that decides
    # what a pod may reach. This chain exists to keep the INTERNET out, and the
    # internet does not arrive on `lxc*`.
    iifname "lxc*" accept
    iifname { "cilium_host", "cilium_net", "cilium_vxlan" } accept

    # ── ICMP: the useful kinds only, and NOT echo on the public side ───
    #
    # Dropping ICMP wholesale is a classic self-inflicted wound: it breaks
    # path-MTU discovery, and on a tunnel whose MTU is already 1420 (1370 once
    # VXLAN is inside it) that surfaces as large responses HANGING with no
    # error anywhere. So `destination-unreachable` -- which carries
    # fragmentation-needed -- is accepted unconditionally, and so is
    # `time-exceeded`.
    #
    # ECHO IS DIFFERENT. It is the one ICMP type that exists to tell a stranger
    # this host is here, and nothing needs it from the internet:
    #   * PMTUD does not use echo.
    #   * The blackbox probe targets the TUNNEL address (10.250.0.1), which
    #     arrives on {{ edge_fw_tunnel_iface }} and is accepted wholesale above.
    # So echo is accepted on the tunnel and dropped on the public NIC, which
    # makes this host silent to a ping sweep without costing any diagnostics
    # that matter.
    #
    # ⚠️ It does NOT make the host unfindable. The published service ports still
    # answer, and a TCP scan finds them regardless -- that is what publishing a
    # game server means. This removes the free "is anything here?" signal, not
    # the service itself.
    icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

    # ICMPv6 neighbour discovery is not optional -- dropping it breaks IPv6 on
    # the link entirely, including the tunnel if it ever runs over v6.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept

    # Echo needs NO rule of its own: `iifname {{ edge_fw_tunnel_iface }} accept`
    # above already admits everything on the tunnel, and the public NIC has no
    # echo rule, so it falls through to `policy drop`. Adding an explicit
    # tunnel-echo accept here would be a redundant rule that reads like the
    # thing doing the work -- and the next person would "tidy" the wrong one.

{% for r in edge_fw_public_tcp %}
    # {{ r.why }}
    iifname "{{ edge_fw_public_iface }}" tcp dport {{ r.port }} accept
{% endfor %}
{% for r in edge_fw_public_udp %}
    # {{ r.why }}
    iifname "{{ edge_fw_public_iface }}" udp dport {{ r.port }} accept
{% endfor %}

    # ── Published services ──────────────────────────────────────────────
{% for r in edge_fw_service_tcp %}
    # {{ r.why }}
    iifname "{{ edge_fw_public_iface }}" tcp dport {{ r.port }} accept
{% endfor %}
{% for r in edge_fw_service_udp %}
    # {{ r.why }}
    iifname "{{ edge_fw_public_iface }}" udp dport {{ r.port }} accept
{% endfor %}
{% for r in edge_fw_service_tcp_dnat | default([]) %}
    # {{ r.why | trim }}
    #
    # 🔴 THIS ACCEPTS THE LISTENER PORT, NOT THE PUBLIC ONE. The prerouting
    # chain below has already rewritten dport {{ r.public_port }} -> {{ r.listener_port }}
    # by the time this chain runs -- DNAT sits at prerouting, which is ahead of
    # the input hook. An accept on {{ r.public_port }} would never match, and the
    # connection would die AFTER a successful DNAT: the packet arrives, gets
    # rewritten, then hits the policy drop. That reads like a broken backend and
    # sends you looking in the cluster.
    iifname "{{ edge_fw_public_iface }}" tcp dport {{ r.listener_port }} accept
{% endfor %}

    # 🔴 EVERYTHING ELSE IS DROPPED, and these are the ones that matter:
    #   10250/tcp     kubelet -- full node API, binds 0.0.0.0
    #    4240/tcp     Cilium health, binds 0.0.0.0
    #    8473/udp     Cilium VXLAN. k3s docs say never expose this.
    #   19001-3/tcp   Envoy admin, metrics and readiness, bind 0.0.0.0
    #    6443/tcp     apiserver, if this node is ever wrongly made a server
    #
    # `node-ip` does NOT close any of them -- it changes what k3s advertises,
    # not what it binds. This chain is the only thing that closes them.
    counter comment "dropped-inbound"
  }
}
{% if edge_fw_service_tcp_dnat | default([]) %}

# ── PUBLIC PRIVILEGED PORTS -> SHIFTED ENVOY LISTENERS ──────────────────────
#
# Why this table exists at all: binding a port below 1024 under `hostNetwork`
# needs NET_BIND_SERVICE, and `gateway-edge-pod-constraints` forbids added
# capabilities unconditionally. Rather than weaken the containment policy in
# front of an internet-facing namespace for the sake of a port number, Envoy
# Gateway is left to shift privileged listeners by +10000 (its default when
# `useListenerPortAsContainerPort` is false) and the rewrite happens here.
#
# ⚠️ A SEPARATE TABLE FROM edge_filter, deliberately. Both are declared-then-
# deleted at the top of this file, so they are rebuilt together and cannot drift
# apart -- but they are different hooks with different priorities, and mixing a
# nat chain into a filter table is how you get rules that never evaluate.
#
# ⚠️ NO postrouting/masquerade chain. The DNAT target is a port on THIS host, so
# the reply leaves from the same address the client sent to and needs no source
# rewriting. Adding masquerade here would rewrite the CLIENT's address and hand
# every connection to Envoy as though it came from the node itself -- which
# would work, and would silently destroy the client IP in every log and every
# rate-limit decision.
table inet edge_nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
{% for r in edge_fw_service_tcp_dnat %}
    # {{ r.public_port }} -> {{ r.listener_port }} ({{ r.public_port }} + 10000, matching Envoy Gateway's shift)
    iifname "{{ edge_fw_public_iface }}" tcp dport {{ r.public_port }} redirect to :{{ r.listener_port }}
{% endfor %}
  }
}
{% endif %}
